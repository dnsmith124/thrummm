# Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Create a key with:
#   keytool -genkeypair -v -keystore thrummm-release.jks -alias thrummm -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks and passwords safe: updates must be signed with the same key.
storeFile=thrummm-release.jks
storePassword=
keyAlias=thrummm
keyPassword=
